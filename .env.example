# Backend configuration. Generate a unique secret before production use:
# python -c "import secrets; print(secrets.token_urlsafe(48))"
APP_ENV=development
SECRET_KEY=GENERATE_A_UNIQUE_SECRET_WITH_THE_COMMAND_ABOVE
DATABASE_URL=sqlite:///./medical_passport.db
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]
SESSION_TTL_MINUTES=720
COOKIE_SECURE=false
DOCUMENT_STORAGE_PATH=private_uploads
DOCUMENT_MAX_SIZE_BYTES=10485760
PUBLIC_APP_URL=http://localhost:3000
# Optional OpenAI-compatible medical extraction endpoint. OCR text is sent to this provider when configured.
MEDICAL_AI_ENDPOINT=
MEDICAL_AI_API_KEY=
MEDICAL_AI_MODEL=
# Number of trusted reverse proxies in front of the API (Next.js proxy = 1, add one per extra load balancer).
# Required behind a proxy so rate limits are per real client, not per proxy.
TRUSTED_PROXY_COUNT=0
# Production only. Generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Losing this key makes stored documents unreadable; keep it in a secrets manager and back it up.
DOCUMENT_ENCRYPTION_KEY=
EMERGENCY_MAX_HOURS=8760
EMERGENCY_ACCESS_RATE_PER_MINUTE=30
