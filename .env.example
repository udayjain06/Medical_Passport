# Backend configuration. Generate a unique secret before production use:
# python -c "import secrets; print(secrets.token_urlsafe(48))"
APP_ENV=development
SECRET_KEY=GENERATE_A_UNIQUE_SECRET_WITH_THE_COMMAND_ABOVE
DATABASE_URL=sqlite:///./medical_passport.db
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]
SESSION_TTL_MINUTES=720
COOKIE_SECURE=false
AUTH_UNIFORM_RESPONSE_MS=150
# Optional shared rate-limit store. Without Redis, limits are process-local.
REDIS_URL=
DOCUMENT_STORAGE_PATH=private_uploads
DOCUMENT_MAX_SIZE_BYTES=10485760
REQUEST_MAX_SIZE_BYTES=12582912
# Production requires ClamAV. Local development can leave scanning off.
MALWARE_SCAN=off
CLAMAV_HOST=127.0.0.1
CLAMAV_PORT=3310
CLAMAV_TIMEOUT_SECONDS=5
PUBLIC_APP_URL=http://localhost:3000
# Optional OpenAI-compatible medical extraction endpoint. OCR text is sent to this provider when configured.
MEDICAL_AI_ENDPOINT=
MEDICAL_AI_API_KEY=
MEDICAL_AI_MODEL=
# Number of trusted reverse proxies in front of the API (Next.js proxy = 1, add one per extra load balancer).
# Required behind a proxy so rate limits are per real client, not per proxy.
TRUSTED_PROXY_COUNT=0
# Preferred ordered JSON list: first key encrypts; all keys decrypt during a rotation.
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Keep old keys in this list until `python -m app.rotate_keys` succeeds and backups are verified.
DOCUMENT_ENCRYPTION_KEYS=[]
# Legacy single-key setting remains supported; prefer DOCUMENT_ENCRYPTION_KEYS for rotation.
DOCUMENT_ENCRYPTION_KEY=
EMERGENCY_MAX_HOURS=8760
EMERGENCY_ACCESS_RATE_PER_MINUTE=30
# Console delivery redacts recipient and message details and is allowed only in development.
EMAIL_PROVIDER=console
EMAIL_FROM="Medical Passport <noreply@example.invalid>"
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_STARTTLS=true
SMTP_USE_SSL=false
RESEND_API_KEY=
# Local E2E only. Requires APP_ENV=test; production startup rejects this flag.
EMAIL_TEST_HOOK_ENABLED=false
